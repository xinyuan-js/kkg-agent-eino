{
  "name": "kkg-agent-eino",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [3000, 8088, 5432, 6379, 19000, 19001],
  "portsAttributes": {
    "3000": {
      "label": "Nuxt Web"
    },
    "8088": {
      "label": "Agent API"
    },
    "19001": {
      "label": "MinIO Console"
    }
  },
  "postCreateCommand": "cp -n .env.example .env || true && go work sync",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go",
        "Vue.volar",
        "bradlc.vscode-tailwindcss"
      ]
    }
  }
}
