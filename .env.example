APP_ENV=dev

AGENT_API_PORT=8088
AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGENT_JWT_SECRET=change-me-to-match-kkg-blog

KKG_BLOG_BASE_URL=http://host.docker.internal:8080
KKG_OJ_BASE_URL=http://host.docker.internal:8121

POSTGRES_DSN=postgres://kkg_agent:kkg_agent@postgres:5432/kkg_agent?sslmode=disable
REDIS_ADDR=redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=kkg_agent
MINIO_SECRET_KEY=kkg_agent_secret

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIM=1024
DASHSCOPE_API_KEY=

RAG_QUESTION_INDEX_MAX_PAGES=3
RAG_QUESTION_INDEX_PAGE_SIZE=20
